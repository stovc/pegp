#!/bin/bash
#
#SBATCH --job-name=filter_bp
#SBATCH --output=mk_gen_consistent.out
#
#SBATCH --time=2:00:00
#
#SBATCH --mem=64G
#
#SBATCH --no-requeue
#SBATCH --export=NONE
unset SLURM_EXPORT_ENV
#
export OMP_NUM_THREADS=1

source /nfs/scistore16/calingrp/sovchinn/.bashrc
conda activate /nfs/scistore16/calingrp/sovchinn/.local/share/mamba/envs/pegp

srun --cpu_bind=verbose python3 scripts/06_mk_genome_consistent.py $1
echo 6 $? >> projects/$1/exit_log.txt
