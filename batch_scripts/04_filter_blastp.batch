#!/bin/bash
#
#SBATCH --job-name=filter
#SBATCH --output=filter.out
#
#SBATCH --time=2:00:00   # HOW LONG DO I NEED?
#
#SBATCH --mem=64G
#
#SBATCH --no-requeue
#SBATCH --export=NONE
unset SLURM_EXPORT_ENV
#
export OMP_NUM_THREADS=1
#
#run the respective binary through SLURM's srun

source /nfs/scistore16/calingrp/sovchinn/.bashrc
conda activate /nfs/scistore16/calingrp/sovchinn/.local/share/mamba/envs/pegp

srun --cpu_bind=verbose python3 scripts/04_filter.py $1 $2 $3 $4
echo 4 $? >> projects/$1/exit_log.txt
