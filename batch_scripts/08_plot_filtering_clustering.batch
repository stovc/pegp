#!/bin/bash
#
#SBATCH --job-name=plot_filter
#SBATCH --output=plot_filter.out
#
#SBATCH --time=2:00:00
#
#SBATCH --mem=32G
#
#SBATCH --no-requeue
#SBATCH --export=NONE
unset SLURM_EXPORT_ENV
#
export OMP_NUM_THREADS=1

source /nfs/scistore16/calingrp/sovchinn/.bashrc
conda activate /nfs/scistore16/calingrp/sovchinn/.local/share/mamba/envs/pegp

srun --cpu_bind=verbose python3 scripts/08_plot_filtering_clustering.py $1
echo 8 $? >> projects/$1/exit_log.txt
