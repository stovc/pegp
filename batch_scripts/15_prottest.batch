#!/bin/bash
#
#SBATCH --job-name=prottest
#SBATCH --output=hmmscan.out
#
#SBATCH --time=1:00:00
#SBATCH --mem=1G
#
#SBATCH --no-requeue
#SBATCH --export=NONE
unset SLURM_EXPORT_ENV
export OMP_NUM_THREADS=1
#

source /nfs/scistore16/calingrp/sovchinn/.bashrc
conda activate /nfs/scistore16/calingrp/sovchinn/.local/share/mamba/envs/pegp

srun bash scripts/15_prottest.sh $1
echo 15 $? >> projects/$1/exit_log.txt
