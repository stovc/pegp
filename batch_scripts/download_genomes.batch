#!/bin/bash
#SBATCH --job-name=download_genomes
#SBATCH --output=slurm_output/download_genomes_%j.out
#SBATCH --error=slurm_output/download_genomes_%j.err
#SBATCH --time=24:00:00
#SBATCH --mem=16G
#SBATCH -c 8
#SBATCH --no-requeue
#SBATCH --export=NONE
unset SLURM_EXPORT_ENV
#
export OMP_NUM_THREADS=1
#

source /nfs/scistore16/calingrp/sovchinn/miniforge3/etc/profile.d/mamba.sh
mamba activate pegp

which python
python -c "import pandas, numpy, Bio; print('env ok')" || { echo "ENV ACTIVATION FAILED"; exit 1; }

cd /nfs/scistore16/calingrp/sovchinn/test/pegp
bash prepare_genomes/download_genomes.sh
