#!/bin/bash
#SBATCH --job-name=align
#SBATCH --output=slurm_output/align_%j.out
#SBATCH --error=slurm_output/align_%j.err
#SBATCH -c 8
#SBATCH --time=48:00:00
#SBATCH --mem=32G
#16G and 24 hrs was not sufficient fot ClpC-core

module load mafft

bash scripts/09_align.sh $1
echo 9 $? >> projects/$1/exit_log.txt
