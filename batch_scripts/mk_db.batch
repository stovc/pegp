#!/bin/bash
#
#SBATCH --job-name=make_db
#SBATCH --output=slurm_output/mk_db_out_%j.out
#SBATCH --error=slurm_output/mk_db_out_%j.err
#SBATCH --time=48:00:00
#
#SBATCH --mem=64G
#
#SBATCH --no-requeue
#SBATCH --export=NONE
unset SLURM_EXPORT_ENV
#
export OMP_NUM_THREADS=1
#

export MAMBA_ROOT_PREFIX=/nfs/scistore16/calingrp/sovchinn/miniforge3
eval "$(/nfs/scistore16/calingrp/sovchinn/miniforge3/bin/mamba shell hook --shell bash)"
mamba activate pegp

python3 mk_db.py /nfs/scistore16/calingrp/sovchinn/test/pegp/data/genomes/r232_rs_one_per_fam /test/pegp/data/genome_info/r232/meta.tsv /nfs/scistore16/calingrp/sovchinn/test/pegp/databases/r232_rs_one_per_fam
