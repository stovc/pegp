#!/bin/bash
#
#SBATCH --job-name=get_translations
#SBATCH --output=get_translations.out
#
#SBATCH --time=2:00:00
#
#SBATCH --mem=64G
#
#SBATCH --no-requeue
#SBATCH --export=NONE
unset SLURM_EXPORT_ENV
#
export OMP_NUM_THREADS=1

source /nfs/scistore16/calingrp/sovchinn/.bashrc
conda activate /nfs/scistore16/calingrp/sovchinn/.local/share/mamba/envs/pegp

srun --cpu_bind=verbose python3 scripts/10_get_translations.py $1 $2
echo 10 $? >> projects/$1/exit_log.txt
