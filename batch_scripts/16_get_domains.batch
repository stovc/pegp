#!/bin/bash
#SBATCH --job-name=domain_data
#SBATCH --output=slurm_output/domain_data_%j.out
#SBATCH --error=slurm_output/domain_data_%j.err
#SBATCH --time=2:00:00   # HOW LONG DO I NEED?
#SBATCH --mem=64G

srun --cpu_bind=verbose python3 scripts/16_domain_data.py $1
echo 16 $? >> projects/$1/exit_log.txt
