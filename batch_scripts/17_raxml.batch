#!/bin/bash
#
#SBATCH --job-name=tree
#SBATCH --output=tree.out
#
#SBATCH -c 16
#
#SBATCH --time=48:00:00
#SBATCH --mem=32G
#
#SBATCH --no-requeue
#SBATCH --export=NONE
unset SLURM_EXPORT_ENV
export OMP_NUM_THREADS=$SLURM_CPUS_PER_TASK
#
source /nfs/scistore16/calingrp/sovchinn/.bashrc
conda activate /nfs/scistore16/calingrp/sovchinn/.local/share/mamba/envs/pegp

srun bash scripts/tree.sh $1
echo 17 $? >> projects/$1/exit_log.txt
